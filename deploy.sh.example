#!/usr/bin/env bash
# ============================================================
# deploy.sh.example — Template skrip deployment OLT
#
# CARA PAKAI:
#   cp deploy.sh.example deploy.sh
#   chmod +x deploy.sh
#   # Edit variabel REMOTE_HOST dan REMOTE_DIR di bawah,
#   # lalu konfigurasikan alias SSH di ~/.ssh/config.
# ============================================================
set -e

# Warna terminal
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${BLUE}=== Memulai Deployment ke VPS ===${NC}"

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --- KONFIGURASI — ubah sesuai server Anda ---
REMOTE_HOST="your-vps-alias"          # Alias SSH di ~/.ssh/config
REMOTE_DIR="/path/to/your/project"    # Path absolut di VPS
REMOTE_USER="your-remote-user"        # User pemilik direktori di VPS
REMOTE_GROUP="www-data"               # Group web server (biasanya www-data)
# ---------------------------------------------

echo -e "${YELLOW}[1/4] Menjalankan test di lokal...${NC}"
cd "$PROJECT_DIR"
php artisan test

echo -e "${YELLOW}[2/4] Melakukan build aset frontend lokal...${NC}"
npm run build

echo -e "${YELLOW}[3/4] Melakukan sinkronisasi file ke VPS...${NC}"
rsync -avz --delete \
    --exclude='.git' \
    --exclude='node_modules' \
    --exclude='vendor' \
    --exclude='.env' \
    --exclude='.DS_Store' \
    --exclude='.phpunit.result.cache' \
    --exclude='database/database.sqlite' \
    --exclude='bootstrap/cache/*.php' \
    --exclude='public/storage' \
    --exclude='storage/logs/*.log' \
    --exclude='storage/framework/cache/data/*' \
    --exclude='storage/framework/views/*' \
    --exclude='storage/app/public/*' \
    --exclude='deploy.sh' \
    "$PROJECT_DIR/" "$REMOTE_HOST:$REMOTE_DIR/"

echo -e "${YELLOW}[4/4] Menjalankan migrasi dan refresh cache di VPS...${NC}"
ssh "$REMOTE_HOST" REMOTE_DIR="$REMOTE_DIR" REMOTE_USER="$REMOTE_USER" REMOTE_GROUP="$REMOTE_GROUP" "bash -s" << 'EOF'
set -e
cd "$REMOTE_DIR"

# Pastikan symbolic link storage mengarah ke path Linux VPS
rm -f public/storage
php artisan storage:link --quiet || true

# Bersihkan bootstrap cache lama agar package:discover selalu akurat
rm -f bootstrap/cache/*.php
php artisan package:discover --ansi

# Jalankan migrasi database (tidak pernah migrate:fresh)
php artisan migrate --force

# Refresh konfigurasi dan cache Laravel
php artisan optimize:clear
php artisan config:cache
php artisan route:cache
php artisan view:cache

# Pastikan izin file untuk web server
sudo chown -R "$REMOTE_USER:$REMOTE_GROUP" "$REMOTE_DIR"
sudo chmod -R 775 storage bootstrap/cache
EOF

echo -e "${GREEN}=== Deployment Berhasil! ===${NC}"
